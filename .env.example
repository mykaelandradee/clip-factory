# Web / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Actions
CLIP_FACTORY_GITHUB_TOKEN=
CLIP_FACTORY_GENERATION_ONLY=false

# Segurança dos tokens OAuth e jobs anônimos
CLIP_FACTORY_TOKEN_ENCRYPTION_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google / YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Worker / processamento local
CLIP_FACTORY_WEB_URL=http://localhost:3000
CLIP_FACTORY_DATA_DIR=./worker/data
CLIP_FACTORY_WORKER_HOST=127.0.0.1
CLIP_FACTORY_WORKER_PORT=8765
CLIP_FACTORY_WORKER_TOKEN=
WHISPER_MODEL=small
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Actions / YouTube cookies
# Configurados como GitHub Secrets, não neste arquivo:
# YOUTUBE_COOKIES_PASSWORD
# R2_ACCOUNT_ID
# R2_BUCKET_NAME
# R2_PUBLIC_URL
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
